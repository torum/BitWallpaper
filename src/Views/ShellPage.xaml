    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App dummy titlebar -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <!-- NavigationView.PaneToggleButton: None draggable area(48px). Exclude from TitleBar -->
                <Button x:Name="DummyButton" Height="36" Width="40" Margin="3,6,0,0" Visibility="Collapsed"/>
            </Grid>
            <Grid x:Name="AppTitleBar" Grid.Column="1" Background="Transparent">
                <!-- Application TitleBar: SetTitleBar in code behinde -->
                <TextBlock x:Name="AppTitleDummyTextBlock" Text="" Margin="0,0,0,0" Opacity="0.9" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <NavigationView Grid.Row="0" Grid.RowSpan="2"
            x:Name="NavigationViewControl"
            Canvas.ZIndex="0"
            IsTitleBarAutoPaddingEnabled="True"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            ExpandedModeThresholdWidth="1007"
            OpenPaneLength ="280"
            IsPaneOpen="{x:Bind ViewModel.IsNavigationViewMenuOpen, Mode=TwoWay}"
            ItemInvoked="NavigationViewControl_ItemInvoked"
            Loaded="NavigationViewControl_Loaded">

            <NavigationView.MenuItems>

