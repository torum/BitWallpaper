                        <ImageIcon Source="ms-appx:///Assets/CryptLogos/btc.svg"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.LtpBtcJpy, Mode=OneWay}" FontWeight="Bold" FontSize="{StaticResource LargeFontSize}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LtpBtcJpyPercentChange, Mode=OneWay}" FontWeight="Normal" FontSize="{StaticResource LargeFontSize}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
                        </Grid>
